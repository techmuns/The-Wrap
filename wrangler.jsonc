{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "the-wrap",
  "compatibility_date": "2026-05-05",
  "compatibility_flags": ["nodejs_compat"],
  // Keep variables and secrets configured in the Cloudflare dashboard rather
  // than here. Without this, `wrangler deploy` publishes a version whose
  // bindings are exactly the ones in this file, so any dashboard-set secret
  // (e.g. an API token) stops reaching the running Worker.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "the-wrap"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
